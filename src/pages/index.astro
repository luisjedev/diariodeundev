---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/retroui/Badge";
import { AuthorAvatar } from "@/components/AuthorAvatar";
import Newsletter from "@/components/Newsletter.astro";
import { Empty } from "@/components/retroui/Empty";
import { formatDate } from "@/lib/format";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.visible)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = posts;
const sidePosts = rest.slice(0, 2);
---

<BaseLayout title="diariodeundev — opinión, experiencias y tecnología">
  <!-- Hero -->
  <section class="border-b-2 border-border bg-background">
    <div class="mx-auto max-w-6xl px-4 py-5 sm:py-7">
      <p class="mb-3 flex items-center gap-2 font-head text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
        <span class="inline-block size-2 bg-primary" aria-hidden="true"></span>
        Confesiones de un desarrollador
      </p>
      <h1 class="font-head text-[2rem] leading-[1.1] sm:text-[2.625rem]">Código, ideas y <span class="underline decoration-primary decoration-[5px] underline-offset-[4px]">todo lo aprendido.</span></h1>
      <p class="mt-3 max-w-lg font-sans text-sm text-muted-foreground sm:text-[15px]">
        Opinión sin filtros, experiencias reales y tecnología.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    {
      posts.length === 0 && (
        <Empty className="mx-auto max-w-md">
          <Empty.Content>
            <Empty.Icon className="size-12 text-foreground" />
            <Empty.Title className="font-head">Todavía no hay artículos</Empty.Title>
            <Empty.Separator className="w-16" />
            <Empty.Description className="font-sans">
              ¡Pronto la primera entrada!
            </Empty.Description>
          </Empty.Content>
        </Empty>
      )
    }

    {
      featured && (
        <div class="grid gap-6 lg:grid-cols-3">
          {/* Tarjeta destacada */}
          <article class="group lg:col-span-2">
            <div class="block h-full">
              <div class="grid h-full overflow-hidden rounded border-2 border-border bg-card shadow-[8px_8px_0_0_var(--border)] sm:grid-cols-2">
                {/* Portada */}
                <div class="relative grid min-h-[260px] place-items-center overflow-hidden border-border bg-primary text-primary-foreground max-sm:border-b-2 sm:border-r-2">
                  {featured.data.cover ? (
                    <Image
                      src={featured.data.cover}
                      alt={`Portada de ${featured.data.title}`}
                      widths={[480, 768, 1152]}
                      sizes="(max-width: 640px) 100vw, 50vw"
                      quality={95}
                      class="absolute inset-0 size-full object-cover"
                    />
                  ) : (
                    <span
                      class="font-head text-[8rem] leading-none opacity-90"
                      aria-hidden="true">D</span
                    >
                  )}
                  <span class="absolute left-3 top-3 bg-foreground px-2 py-1 font-head text-xs uppercase tracking-wider text-background">
                    Destacado
                  </span>
                  <span class="absolute bottom-3 right-3 bg-foreground px-2 py-1 font-head text-xs uppercase tracking-[0.2em] text-background">
                    diariodeundev
                  </span>
                </div>

                {/* Contenido */}
                <div class="flex flex-col p-6">
                  <div class="mb-3 flex flex-wrap items-center gap-3">
                    <Badge variant="solid" size="sm">{featured.data.category}</Badge>
                    <time
                      class="flex items-center gap-1.5 font-sans text-xs text-muted-foreground"
                    >
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
                      {formatDate(featured.data.pubDate)}
                    </time>
                  </div>

                  <h2 class="font-head text-2xl leading-tight decoration-primary decoration-2 underline-offset-4 group-hover:underline sm:text-3xl">
                    {featured.data.title}
                  </h2>

                  <p class="mt-3 line-clamp-3 font-sans text-muted-foreground">
                    {featured.data.description}
                  </p>

                  <div class="mt-5 flex items-center gap-2">
                    <AuthorAvatar name={featured.data.author} className="size-8 border-2" />
                    <span class="font-head text-sm">{featured.data.author}</span>
                  </div>

                  <div class="mt-auto pt-6">
                    <a
                      href={`/blog/${featured.id}`}
                      class="inline-flex items-center gap-2 rounded border-2 border-border bg-primary px-5 py-2 font-head text-sm text-primary-foreground shadow-[3px_3px_0_0_var(--border)] transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none"
                    >
                      Leer artículo →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </article>

          {/* Columna de entradas recientes */}
          <div class="flex h-full flex-col gap-6">
            {sidePosts.map((post) => (
              <a href={`/blog/${post.id}`} class="group flex flex-1">
                <article class="flex w-full flex-col rounded border-2 border-border bg-card p-5 shadow-[5px_5px_0_0_var(--border)] transition-all duration-200 group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 group-hover:shadow-[7px_7px_0_0_var(--border)]">
                  <div class="mb-3 flex flex-wrap items-center gap-3">
                    <Badge variant="solid" size="sm">{post.data.category}</Badge>
                    <time class="flex items-center gap-1.5 font-sans text-xs text-muted-foreground">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>

                  <h3 class="font-head text-lg leading-tight decoration-primary decoration-2 underline-offset-4 group-hover:underline">
                    {post.data.title}
                  </h3>

                  <div class="mt-auto pt-4 flex items-center gap-2">
                    <AuthorAvatar name={post.data.author} className="size-7 border-2" />
                    <span class="font-head text-sm">{post.data.author}</span>
                  </div>
                </article>
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      posts.length > 0 && (
        <div class="mt-12 flex justify-center">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 rounded border-2 border-border bg-secondary px-7 py-3 font-head text-secondary-foreground shadow-[5px_5px_0_0_var(--primary)] transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_0_var(--primary)]"
          >
            Ver todos los artículos →
          </a>
        </div>
      )
    }
  </div>

  <Newsletter />
</BaseLayout>
