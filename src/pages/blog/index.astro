---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/retroui/Badge";
import { Empty } from "@/components/retroui/Empty";
import { formatDate } from "@/lib/format";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.visible)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Degradados de respaldo para los artículos que todavía no tengan portada.
const gradients = [
  "linear-gradient(135deg,#2563eb 0%,#7c3aed 30%,#db2777 55%,#f97316 78%,#facc15 100%)",
  "linear-gradient(160deg,#fbbf24 0%,#fb7185 45%,#a78bfa 75%,#1e293b 100%)",
  "linear-gradient(160deg,#e2e8f0 0%,#94a3b8 45%,#475569 75%,#1e293b 100%)",
  "linear-gradient(150deg,#f9a8d4 0%,#fb7185 40%,#fda4af 70%,#e2e8f0 100%)",
  "linear-gradient(140deg,#34d399 0%,#22d3ee 40%,#3b82f6 75%,#1e3a8a 100%)",
];
---

<BaseLayout
  title="Todos los artículos — diariodeundev"
  description="El archivo completo del diario: opinión, experiencias y tecnología."
>
  <section class="border-b-2 border-border bg-background">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:py-12">
      <a
        href="/"
        class="inline-block font-head text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        ← Volver al inicio
      </a>
      <h1 class="mt-4 font-head text-3xl leading-[1.05] sm:text-4xl">
        <span class="underline decoration-primary decoration-[5px] underline-offset-[4px]">Todos los artículos</span>
      </h1>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
    {
      posts.length === 0 ? (
        <Empty className="mx-auto max-w-md">
          <Empty.Content>
            <Empty.Icon className="size-12 text-foreground" />
            <Empty.Title className="font-head">Todavía no hay artículos</Empty.Title>
            <Empty.Separator className="w-16" />
            <Empty.Description className="font-sans">
              ¡Pronto la primera entrada!
            </Empty.Description>
          </Empty.Content>
        </Empty>
      ) : (
        <ul class="flex flex-col gap-14 sm:gap-20">
          {posts.map((post, i) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col items-stretch gap-6 sm:flex-row sm:items-center sm:gap-10"
              >
                {/* Miniatura */}
                <div class="w-full sm:w-auto sm:shrink-0">
                  {post.data.cover ? (
                    <Image
                      src={post.data.cover}
                      alt={`Portada de ${post.data.title}`}
                      widths={[400, 800, 1200, 1536]}
                      sizes="(max-width: 640px) 100vw, 200px"
                      quality={95}
                      class="h-[180px] w-full rounded-lg border-2 border-border object-cover shadow-[6px_6px_0_0_var(--primary)] transition-all duration-200 group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 group-hover:shadow-[9px_9px_0_0_var(--primary)] sm:h-[150px] sm:w-[200px]"
                    />
                  ) : (
                    <div
                      class="h-[180px] w-full rounded-lg border-2 border-border shadow-[6px_6px_0_0_var(--primary)] transition-all duration-200 group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 group-hover:shadow-[9px_9px_0_0_var(--primary)] sm:h-[150px] sm:w-[200px]"
                      style={`background:${gradients[i % gradients.length]}`}
                    />
                  )}
                </div>

                {/* Contenido */}
                <div class="min-w-0 flex-1">
                  <Badge
                    variant="solid"
                    size="sm"
                    className="rounded-md uppercase tracking-wider"
                  >
                    {post.data.category}
                  </Badge>
                  <h2 class="mt-4 font-head font-bold text-xl leading-tight sm:text-3xl">
                    {post.data.title}
                  </h2>
                  <p class="mt-4 font-sans text-sm text-muted-foreground sm:text-base">
                    Por <span class="font-semibold text-foreground">{post.data.author}</span>
                    <span class="mx-2">·</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                  </p>
                </div>

                {/* Botón flecha */}
                <div class="hidden shrink-0 sm:block">
                  <span class="grid h-12 w-14 place-items-center rounded-md border-2 border-border bg-primary text-primary-foreground shadow-[3px_3px_0_0_var(--border)] transition-all duration-200 group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-hover:shadow-none">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
