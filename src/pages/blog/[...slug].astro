---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/retroui/Badge";
import { AuthorAvatar } from "@/components/AuthorAvatar";
import Newsletter from "@/components/Newsletter.astro";
import { formatDate } from "@/lib/format";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft && data.visible);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, cover, category, pubDate, updatedDate, author, tags } =
  post.data;
---

<BaseLayout title={`${title} — diariodeundev`} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a
      href="/blog"
      onclick="history.length > 1 && (event.preventDefault(), history.back())"
      class="inline-block font-head text-sm text-muted-foreground transition-colors hover:text-foreground"
    >
      ← Volver
    </a>

    <header class="mt-6 border-b-2 border-border pb-6">
      <Badge variant="surface" size="sm">{category}</Badge>

      <h1 class="mt-4 font-head text-3xl leading-tight sm:text-5xl">
        {title}
      </h1>
      <p class="mt-4 font-sans text-lg text-muted-foreground">{description}</p>

      <div class="mt-6 flex items-center gap-3">
        <AuthorAvatar name={author} className="size-10 border-2" />
        <div class="leading-tight">
          <p class="font-head text-sm">{author}</p>
          <p class="font-sans text-xs text-muted-foreground">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {
              updatedDate && (
                <span> · actualizado el {formatDate(updatedDate)}</span>
              )
            }
          </p>
        </div>
      </div>
    </header>

    {
      cover && post.id !== "esto-sirve-para-algo" && (
        <Image
          src={cover}
          alt={`Portada de ${title}`}
          widths={[640, 960, 1280, 1536]}
          sizes="(max-width: 768px) 100vw, 768px"
          quality={95}
          class="mt-8 aspect-[3/2] w-full rounded-lg border-2 border-border object-cover shadow-[6px_6px_0_0_var(--primary)]"
          loading="eager"
        />
      )
    }

    <div class="post-content mt-8">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <footer class="mt-10 flex flex-wrap gap-2 border-t-2 border-border pt-6">
          {tags.map((tag) => (
            <Badge variant="outline" size="sm">
              #{tag}
            </Badge>
          ))}
        </footer>
      )
    }

    <div class="mt-12 flex justify-center">
      <a
        href="/blog"
        onclick="history.length > 1 && (event.preventDefault(), history.back())"
        class="inline-flex items-center gap-2 rounded border-2 border-border bg-secondary px-7 py-3 font-head text-secondary-foreground shadow-[5px_5px_0_0_var(--primary)] transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_0_var(--primary)]"
      >
        ← Volver
      </a>
    </div>
  </article>

  <Newsletter />
</BaseLayout>
