---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/retroui/Button";
---

<BaseLayout title="404 — diariodeundev">
  <section
    class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center"
  >
    <p class="font-head text-7xl sm:text-9xl">404</p>
    <h1 class="mt-4 font-head text-2xl sm:text-3xl">Esta página no existe</h1>
    <p class="mt-3 font-sans text-muted-foreground">
      Puede que la entrada se haya movido o nunca llegara a publicarse.
    </p>
    <a href="/" class={buttonVariants({ variant: "default", size: "lg" }) + " mt-8"}>
      Volver al inicio
    </a>
  </section>
</BaseLayout>
