  },
  {
    label: "Email",
    href: "mailto:luisjedev@gmail.com",
    icon: "M22 4H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-.4 4.25-8.54 5.34a2 2 0 0 1-2.12 0L2.4 8.25a.85.85 0 1 1 .9-1.44L12 12.18l8.7-5.37a.85.85 0 1 1 .9 1.44z",
