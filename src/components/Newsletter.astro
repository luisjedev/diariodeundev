---
// Bloque de suscripción a la newsletter (envía a /api/subscribe → Resend)
import { NewsletterForm } from "@/components/NewsletterForm";
---

<section class="border-t-2 border-border bg-[#f5ece7] dark:bg-background">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <div
      class="overflow-hidden rounded border-2 border-border bg-card shadow-[8px_8px_0_0_var(--border)]"
    >
      {/* Cabecera */}
      <div class="border-b-2 border-border bg-primary px-6 py-5">
        <h2 class="font-head text-2xl text-primary-foreground sm:text-3xl">
          Únete a la newsletter
        </h2>
      </div>

      {/* Cuerpo */}
      <div class="p-6 sm:p-8">
        <p class="font-sans text-sm text-muted-foreground sm:text-[15px]">
          Recibe los nuevos artículos y novedades directamente en tu correo. Sin
          spam, puedes darte de baja cuando quieras.
        </p>

        <NewsletterForm client:visible />
      </div>
    </div>
  </div>
</section>
