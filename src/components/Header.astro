---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/sobre-mi", label: "Sobre mí" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b-2 border-border bg-background">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="group inline-flex items-center gap-[3px]">
      <span
        class="grid size-9 place-items-center border-2 border-border bg-primary font-head text-lg text-primary-foreground shadow-[2px_2px_0_0_var(--border)] transition-transform group-hover:-translate-y-0.5"
        >D</span
      >
      <span class="font-head text-lg leading-none sm:text-xl">
        iariodeun<span class="bg-primary px-1 text-primary-foreground">dev</span>
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-3">
      {/* Enlaces inline — solo desktop */}
      <nav class="hidden items-center gap-3 sm:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={[
                "px-2 py-1 font-head text-base transition-colors hover:text-primary",
                isActive(link.href) &&
                  "underline decoration-primary decoration-2 underline-offset-4",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema"
        class="grid size-9 place-items-center border-2 border-border bg-card shadow-[2px_2px_0_0_var(--border)] transition-all hover:translate-y-0.5 hover:shadow-none"
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      {/* Botón hamburguesa — solo móvil */}
      <button
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-9 place-items-center border-2 border-border bg-card shadow-[2px_2px_0_0_var(--border)] transition-all hover:translate-y-0.5 hover:shadow-none sm:hidden"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

{/* Drawer lateral móvil */}
<div id="mobile-menu" class="fixed inset-0 z-50 hidden sm:hidden">
  <div id="menu-backdrop" class="absolute inset-0 bg-black/50"></div>
  <nav
    aria-label="Menú principal"
    class="absolute inset-y-0 right-0 flex w-64 max-w-[80vw] translate-x-full flex-col gap-2 border-l-2 border-border bg-background p-4 shadow-[-4px_0_0_0_var(--border)] transition-transform duration-200 data-[open]:translate-x-0"
  >
    <div class="mb-2 flex items-center justify-between border-b-2 border-border pb-3">
      <span class="font-head text-lg">Menú</span>
      <button
        id="menu-close"
        type="button"
        aria-label="Cerrar menú"
        class="grid size-9 place-items-center border-2 border-border bg-card shadow-[2px_2px_0_0_var(--border)] transition-all hover:translate-y-0.5 hover:shadow-none"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "border-2 border-border bg-card px-3 py-2 font-head text-base shadow-[2px_2px_0_0_var(--border)] transition-all hover:translate-y-0.5 hover:text-primary hover:shadow-none",
            isActive(link.href) &&
              "underline decoration-primary decoration-2 underline-offset-4",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  (() => {
    const menu = document.getElementById("mobile-menu");
    const panel = menu?.querySelector("nav");
    const toggle = document.getElementById("menu-toggle");
    const backdrop = document.getElementById("menu-backdrop");
    const closeBtn = document.getElementById("menu-close");
    if (!menu || !panel || !toggle) return;

    const open = () => {
      menu.classList.remove("hidden");
      // Fuerza un reflow para que arranque la transición de entrada
      void panel.offsetWidth;
      panel.setAttribute("data-open", "");
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      panel.removeAttribute("data-open");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      const hide = () => menu.classList.add("hidden");
      panel.addEventListener("transitionend", hide, { once: true });
    };

    toggle.addEventListener("click", open);
    backdrop?.addEventListener("click", close);
    closeBtn?.addEventListener("click", close);
    menu
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel.hasAttribute("data-open")) close();
    });
  })();
</script>
